# Salin ke .env dan isi seperlunya. Jangan commit .env yang sudah diisi.
# RAG_API_KEY kosong = tanpa auth (hanya untuk tes lokal).
RAG_API_KEY=
# Path PDF dan ChromaDB (default: folder pdf/ dan chroma_db/ di samping app.py)
# RAG_PDF_DIR=./pdf
# RAG_CHROMA_DIR=./chroma_db
# Model (default sudah sesuai percobaan asli)
# RAG_EMBED_MODEL=BAAI/bge-m3
# RAG_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
GROQ_API_KEY=
GROQ_MODEL=